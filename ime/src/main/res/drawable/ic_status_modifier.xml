<?xml version="1.0" encoding="utf-8"?>
<!--
  keys-and-modifiers.md SS13.1: the system status bar icon shown while any modifier is active or
  locked, a Sym page is open, or nav mode is on. `StatusBarModifierIcon.choose` (core/keys) decides
  which of those 28 states applies on every strip refresh; this one drawable is shown or hidden by
  that decision (`InputMethodService.showStatusIcon`/`hideStatusIcon`, KeyboardSession.refreshStatusIcon).

  A single drawable stands in for all 28 combinations here: a bold "M" (Modifier), drawn as a
  stroked path rather than 26 hand-authored icons. See this task's report for that trade-off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M4,19 L4,5 L12,14 L20,5 L20,19"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
