<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Key feedback. The keyboard vibrates on its own account, not through the
         notification channel, because notification vibration being off must not
         silence typing feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Dictation: spec dictation.md SS10. A keyboard service cannot show the runtime
         permission dialog itself, so DictationController opens DictationPermissionActivity
         to ask for it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <service
            android:name="brobata.physiboard.ime.PhysiBoardInputMethodService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- spec dictation.md SS10: "translucent, title-less ... new task, clear top; excluded
             from recents; single task; empty task affinity." -->
        <activity
            android:name="brobata.physiboard.ime.DictationPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />
    </application>

</manifest>
