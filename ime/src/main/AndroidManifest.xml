<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- dictation.md SS4.1, SS4.2: the speech engines. Without this, package visibility hides
         every recognition service the keyboard did not declare an interest in: on the Titan the
         on-device one (Android System Intelligence) was filtered out of the picker and the
         "is recognition available" probe (AppsFilter logged the block on every trigger, D18). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Key feedback. The keyboard vibrates on its own account, not through the
         notification channel, because notification vibration being off must not
         silence typing feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Dictation: spec dictation.md SS10. A keyboard service cannot show the runtime
         permission dialog itself, so DictationController opens DictationPermissionActivity
         to ask for it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Screen trackpad and caret badge: spec trackpad-caret-nav.md SS2.1, SS4.1. Both overlays
         are TYPE_APPLICATION_OVERLAY windows drawn above the app being typed into, so both need
         "Display over other apps". OverlayPermission.availability re-checks the real grant on
         every show (never cached); this declaration alone does not grant it, it only lets the
         user grant it from the system's per-app permission screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Touch-screen-awake: spec trackpad-caret-nav.md SS6. A screen-bright wake lock pulses on
         every touch down on the keyboard's own chrome so the display's timeout does not fire
         mid-typing; there is no preference for this, it is always on. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The system spell checker (autocorrect-suggestions.md SS18) treats the words an app's "Add to
         dictionary" saves in Android's user dictionary as known, so the underline goes away. Android
         lets only the current keyboard and spell checker read that dictionary; it is read on the
         phone and never leaves it. -->
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />

    <application>
        <service
            android:name="brobata.physiboard.ime.PhysiBoardInputMethodService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- autocorrect-suggestions.md SS18: the system spell checker. Same process as the keyboard
             (no android:process), so both read one copy of each dictionary. BIND_TEXT_SERVICE means
             only the system can bind it. -->
        <service
            android:name="brobata.physiboard.ime.PhysiBoardSpellCheckerService"
            android:label="@string/spell_checker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/spellchecker" />
        </service>

        <!-- spec dictation.md SS10: "translucent, title-less ... new task, clear top; excluded
             from recents; single task; empty task affinity." -->
        <activity
            android:name="brobata.physiboard.ime.DictationPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />

        <!-- spec dictation.md SS11.3: the orange side key's long-press trampoline. "exported;
             excluded from recents; own empty task affinity; single instance; no history." The
             vendor launches it directly by package/activity, which is why it must be exported. -->
        <activity
            android:name="brobata.physiboard.ime.AssistantTriggerActivity"
            android:exported="true"
            android:theme="@style/Theme.PhysiBoard.AssistantTrigger"
            android:excludeFromRecents="true"
            android:taskAffinity="brobata.physiboard.assistanttrigger"
            android:launchMode="singleInstance"
            android:noHistory="true" />

        <!-- layers-sym-alt.md SS4.5: a GIF sent from the GIF page reaches the app as a content URI
             (InputConnection.commitContent) with a one-off read grant; only the cache path
             `gif-share/` is exposed, and it holds at most the last few GIFs sent. -->
        <provider
            android:name="brobata.physiboard.ime.actions.GifFileProvider"
            android:authorities="${applicationId}.gifshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gif_share_paths" />
        </provider>
    </application>

</manifest>
