<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's foreground layer: a Titan keycap seen face on, its skirt and its dished
     face, with a terminal prompt (>_) in Signal Amber on the face. Everything sits inside the
     66 dp safe zone, so any launcher mask keeps the whole cap (docs/design/design-system.md, "Identity"). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Skirt: the cap's sides, catching a little light at the bottom. -->
    <path
        android:fillColor="#FF334155"
        android:pathData="M41,31 L67,31 A10,10 0 0 1 77,41 L77,69 A10,10 0 0 1 67,79 L41,79 A10,10 0 0 1 31,69 L31,41 A10,10 0 0 1 41,31 Z" />
    <!-- Face: the top of the key, set up and in from the skirt. -->
    <path
        android:fillColor="#FF1E293B"
        android:pathData="M42,34 L66,34 A7,7 0 0 1 73,41 L73,65 A7,7 0 0 1 66,72 L42,72 A7,7 0 0 1 35,65 L35,41 A7,7 0 0 1 42,34 Z" />
    <!-- The prompt. -->
    <path
        android:strokeColor="#FFF59E0B"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M44,46 L51,53 L44,60 M56,60 L65,60" />
</vector>
