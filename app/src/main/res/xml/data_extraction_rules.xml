<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+ (API 31+). Cloud backup and device-to-device transfer carry
   the same set: every preferences file except the recent-emoji cache, custom layouts, the
   nav-mode key mappings, variations and the user dictionary.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="recent_emojis_prefs.xml"/>
        <include domain="file" path="keyboard_layouts/"/>
        <include domain="file" path="ctrl_key_mappings.json"/>
        <include domain="file" path="variations.json"/>
        <include domain="file" path="user_defaults.json"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="recent_emojis_prefs.xml"/>
        <include domain="file" path="keyboard_layouts/"/>
        <include domain="file" path="ctrl_key_mappings.json"/>
        <include domain="file" path="variations.json"/>
        <include domain="file" path="user_defaults.json"/>
    </device-transfer>
</data-extraction-rules>
