<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and below. Android 12+ reads data_extraction_rules.xml instead;
   keep the two files in step.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="recent_emojis_prefs.xml"/>
    <include domain="file" path="keyboard_layouts/"/>
    <include domain="file" path="ctrl_key_mappings.json"/>
    <include domain="file" path="variations.json"/>
    <include domain="file" path="user_defaults.json"/>
</full-backup-content>
