<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification permission (required from Android 13 on) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Vibration permission (required for haptic feedback) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Restarts the screen timeout after a touch on the keyboard -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    
    <!-- Speech recognition permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Internet permission (required for the update check) -->
    <uses-permission android:name="android.permission.INTERNET" />


    <!-- Permission to show overlay windows (screen trackpad) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Writes Settings.System for the Fn->Ctrl mapping (Titan 2 Elite) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Query for every installed app that can be launched -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- Dictation engine picker: list every installed speech recognition service -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>

        <!-- Hold Sym for the assistant: resolve whichever voice-interaction intent it honours -->
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <intent>
            <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
        </intent>
        
        <!-- Query for launchers -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>

        <!-- Optional QuickLauncher backend: Niagara Launcher search deep link -->
        <package android:name="bitpit.launcher" />
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="io.homeassistant.companion.android" />
        <package android:name="com.clicks.companionapp" />
    </queries>

    <application
        android:name=".PastieraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pastiera">
        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:label="${appLabel}"
            android:theme="@style/Theme.Pastiera" />
        
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="${appLabel}"
            android:theme="@style/Theme.Pastiera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SoftwareKeyboardModeActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:label="@string/software_keyboard_mode_toggle_shortcut_short"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="it.palsoftware.pastiera.action.TOGGLE_SOFTWARE_KEYBOARD_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <!-- SYM customization activity -->
        <!-- The orange side key can only be aimed at an activity, so this is the address the
             vendor layer launches; it starts the assistant listening and finishes. -->
        <activity
            android:name=".inputmethod.AssistantTriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:label="@string/side_key_assistant_title"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Pastiera.Trampoline" />

        <activity
            android:name=".SymCustomizationActivity"
            android:exported="false"
            android:label="@string/sym_customize_title"
            android:theme="@style/Theme.Pastiera" />
        
        <!-- Settings activity -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Pastiera" />
        
        <!-- Activity that manages input method subtype languages -->
        <activity
            android:name=".LanguagesActivity"
            android:exported="false"
            android:label="@string/languages_title"
            android:theme="@style/Theme.Pastiera" />
        
        <activity
            android:name=".dictionaries.InstalledDictionariesActivity"
            android:exported="false"
            android:label="@string/installed_dictionaries_title"
            android:theme="@style/Theme.Pastiera.InstalledDictionariesAnimation" />

        <activity
            android:name=".layout.OnlineLayoutsActivity"
            android:exported="false"
            android:label="@string/online_layouts_title"
            android:theme="@style/Theme.Pastiera" />

        <!-- Activity for trackpad debug -->
        <activity
            android:name=".TrackpadDebugActivity"
            android:exported="false"
            android:label="Trackpad Debug"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- Input method service for the physical keyboard -->
        <service
            android:name=".inputmethod.PhysicalKeyboardInputMethodService"
            android:label="${imeLabel}"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Notification ring: a glow around the camera hole while the screen is otherwise off.
             The listener is bound by the system once notification access is granted; the
             activity is what the system launches for the ring's full-screen notification. -->
        <service
            android:name=".ring.NotificationRingListener"
            android:exported="true"
            android:label="@string/ring_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".ring.NotificationRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="brobata.physiboard.ring"
            android:theme="@style/Theme.Pastiera.Ring" />
        <activity
            android:name=".ring.RingAdjustActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Pastiera.Ring" />


        <!-- Helper activity for speech recognition -->
        <activity
            android:name=".inputmethod.SpeechRecognitionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.google.android.inputmethod.latin" />
        
        <!-- Helper activity that requests the microphone permission -->
        <activity
            android:name=".inputmethod.PermissionRequestActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />
        
        <!-- Activity for assigning launcher shortcuts -->
        <activity
            android:name=".inputmethod.LauncherShortcutAssignmentActivity"
            android:theme="@style/Theme.Pastiera.OverlayDialog"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <activity
            android:name=".inputmethod.AddSubstitutionActivity"
            android:theme="@style/Theme.Pastiera.OverlayDialog"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <activity
            android:name=".inputmethod.QuickLauncherActivity"
            android:theme="@style/Theme.Pastiera.QuickLauncherOverlay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:noHistory="true"
            android:finishOnTaskLaunch="true" />

        <!-- Shizuku provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
