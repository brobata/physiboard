<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- app-shell.md SS8.2: without this, package visibility (AppsFilter) hides every other
         installed input-method service from InputMethodManager#getEnabledInputMethodList() and
         from resolving Settings.Secure#default_input_method, so the enabled/selected probe can
         never tell PhysiBoard apart from another keyboard on the phone (including a differently
         flavored build of itself, e.g. dev vs release applicationId). -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <!--
          per-app-behavior.md SS4: every per-app list is chosen from "the installed apps". Android 11
          hides packages an app has not declared an interest in, and without this the pickers offered
          five system apps out of the four hundred and ninety-five installed on the maintainer's
          phone: Chrome, Teams and every other app they actually type in were missing, and the two
          that were on a list already showed as bare package names because their labels could not be
          read either (2026-09-29). This is the narrow declaration for "apps with a launcher entry",
          not QUERY_ALL_PACKAGES.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- app-shell.md SS13.2: the update checker's one GitHub GET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- app-shell.md SS4.4: the home screen's one-time POST_NOTIFICATIONS prompt on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- app-shell.md SS22.2: enableOnBackInvokedCallback opts every activity into Android 14's
         predictive back, so the back swipe previews the screen underneath (the NavHost scrubs its
         pop transition with the gesture) instead of cutting to it. -->
    <application
        android:name="brobata.physiboard.app.PhysiBoardApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhysiBoard"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name="brobata.physiboard.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- expansion-clipboard-pickers-launcher.md SS6.4: the assignment sheet, "a transparent,
             animation-free activity (excluded from recents, no history, single-top)", answered
             for the keyboard's ASSIGN_LAUNCHER_KEY intent (same package only). -->
        <activity
            android:name="brobata.physiboard.app.settings.ui.LauncherAssignmentActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="brobata.physiboard.action.ASSIGN_LAUNCHER_KEY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- autocorrect-suggestions.md SS8.5: the "Add substitution" sheet, same transparent,
             animation-free, excluded-from-recents pattern as the assignment sheet above, answered
             for the keyboard's ADD_SUBSTITUTION intent (same package only). -->
        <activity
            android:name="brobata.physiboard.app.settings.ui.AddSubstitutionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="brobata.physiboard.action.ADD_SUBSTITUTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- app-shell.md SS10.5: the debug report's file share, cache path `debug-reports/`. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
